load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

pkg_tar(
    name = "paper_layer",
    srcs = ["@paper_jar//file:file"],
    package_dir = "app",
    mode = "0644",
    visibility = ["//visibility:public"],
)

image_manifest(
    name = "paper",
    base = "@temurin_java25",
    layers = [":paper_layer"],
    entrypoint = ["java", "-jar", "/app/paper-26.2-132.jar", "nogui"],
    config_fragment = "paper_config.json",
    working_dir = "/data",
    visibility = ["//visibility:public"],
)

image_load(
    name = "paper_load",
    image = ":paper",
    tag = "paper:latest",
)

image_push(
    name = "paper_push",
    image = ":paper",
    destination_file = ":image_destination.txt",
    tag_file = ":image_tags.txt",
)

filegroup(
    name = "paper_tarball",
    srcs = [":paper_load"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)
